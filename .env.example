# ==========================================
# SEWSTUDIO - VARIABLES DE ENTORNO
# ==========================================

# 1. Base de Datos (PostgreSQL)
# En Render: se autocompleta con el connection string de la base de datos PostgreSQL creada
DATABASE_URL="postgresql://sewstudio_user:password@localhost:5432/sewstudio?schema=public"

# 2. Autenticación (NextAuth.js v5 / Auth.js)
# Generar una clave secreta segura con: openssl rand -base64 32
AUTH_SECRET="tu_clave_secreta_super_segura_de_al_menos_32_caracteres"
NEXTAUTH_SECRET="tu_clave_secreta_super_segura_de_al_menos_32_caracteres"

# URL pública de la aplicación
# Local: http://localhost:3000
# En Render: https://sewstudio-web.onrender.com o tu dominio personalizado
NEXTAUTH_URL="http://localhost:3000"

# Permite confiar en proxies inversos (Render y Cloudflare) para resolver callbacks de autenticación
AUTH_TRUST_HOST="true"

# 3. Inteligencia Artificial (Groq API)
# Obtén tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY="gsk_tu_clave_de_groq_aqui"

# (Opcional) OpenAI API Key
OPENAI_API_KEY=""

# 4. Modo de Entorno
NODE_ENV="production"
PORT=3000
